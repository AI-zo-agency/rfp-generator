PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:3000

# Legacy SQLite fallback paths (used only when Supabase is not configured)
DATABASE_PATH=../frontend/data/rfps.db
PDF_STORAGE_PATH=../frontend/storage/pdfs

# Supabase — Postgres (primary when configured) + Storage (RFP PDFs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RFP_BUCKET=rfp-pdfs

# Supermemory — one container tag for proposals, KB, and all RFP content
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=zo-agency

# Google Drive OAuth (your user account — not a service account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional shared drive name for folder listing API
GOOGLE_DRIVE_SHARED_DRIVE_NAME=RFPs

# Optional: bulk ingest script (scripts/ingest_drive_folder_to_supermemory.py)
# DRIVE_INGEST_FOLDER_ID=

# Go/No-Go analysis — OpenRouter primary, Fireworks fallback
# Leave OPENROUTER_API_KEY empty if you only use Fireworks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# State-canonicalization gates (default off — enable after fixture FP review)
# CONSISTENCY_CRITICALS_BLOCK=true
# T1_GATES_BLOCK=true
# OVERLAP_GATES_BLOCK=true
# PERSIST_PHASE2_EVIDENCE_CORPUS=true
# JIT_RETRIEVAL_ON_MISS=true
# BUDGET_BEFORE_DRAFTING=false
# MONEY_SLOTS_BLOCK=true
# ADVERSARIAL_REPAIR_LOOP=true
# ADVERSARIAL_AUDIT_BLOCK=false
# ADVERSARIAL_REPAIR_MAX_ROUNDS=3
# ADVERSARIAL_REPAIR_MAX_ATTEMPTS_PER_FINDING=2
# ADVERSARIAL_REPAIR_TIME_BUDGET_SEC=540
