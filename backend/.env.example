PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:3000

# Legacy SQLite fallback paths (used only when Supabase is not configured)
DATABASE_PATH=../frontend/data/rfps.db
PDF_STORAGE_PATH=../frontend/storage/pdfs

# Supabase — Postgres (primary when configured) + Storage (RFP PDFs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RFP_BUCKET=rfp-pdfs

# Supermemory — one container tag for proposals, KB, and all RFP content
SUPERMEMORY_API_KEY=
SUPERMEMORY_SOURCE_API_KEY=
SUPERMEMORY_CONTAINER_TAG=zo-agency

# Google Drive OAuth (your user account — not a service account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional shared drive name for folder listing API
GOOGLE_DRIVE_SHARED_DRIVE_NAME=RFPs

# Optional: bulk ingest script (scripts/ingest_drive_folder_to_supermemory.py)
# DRIVE_INGEST_FOLDER_ID=

# LLM providers — OpenRouter / Gemini only (Fireworks disabled by default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# LLM_DISABLE_FIREWORKS=true
# FIREWORKS_API_KEY=   # unused while LLM_DISABLE_FIREWORKS is true
# FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# LLM_PREFER_FIREWORKS=false

# Anthropic prompt caching (Claude models via OpenRouter). On by default: the
# repeated prompt prefix is billed at ~0.1x instead of full input rate. The model
# receives identical text either way, so output quality is unaffected.
# LLM_DISABLE_PROMPT_CACHE=false   # kill switch — restores pre-caching behaviour
# LLM_CACHE_TTL_1H=false           # 5-min TTL by default; 1h costs 2x on writes.
#                                  # Only worth enabling if the call log shows
#                                  # cache writes without matching reads.

# State-canonicalization gates (default off — enable after fixture FP review)
# CONSISTENCY_CRITICALS_BLOCK=true
# T1_GATES_BLOCK=true
# OVERLAP_GATES_BLOCK=true
# PERSIST_PHASE2_EVIDENCE_CORPUS=true
# JIT_RETRIEVAL_ON_MISS=true
# BUDGET_BEFORE_DRAFTING=false
# MONEY_SLOTS_BLOCK=true
# ADVERSARIAL_REPAIR_LOOP=true
# ADVERSARIAL_AUDIT_BLOCK=false
# ADVERSARIAL_REPAIR_MAX_ROUNDS=3
# ADVERSARIAL_REPAIR_MAX_ATTEMPTS_PER_FINDING=3
# ADVERSARIAL_REPAIR_TIME_BUDGET_SEC=540
# ADVERSARIAL_REPAIR_MAX_FINDINGS_PER_ROUND=12
# ADVERSARIAL_REPAIR_LLM_AUDIT_EACH_ROUND=false
